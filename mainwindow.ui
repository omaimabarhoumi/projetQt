  <property name="styleSheet">
   <string notr="true">/* Dark Theme for the entire application */
QMainWindow {
    background-color: #02355F; /* Navy blue background */
}

QWidget {
    background-color: #02355F;
}

/* Styling for Labels */
QLabel {
    font-size: 14px;
    color: #ffffff; /* White text color */
}

/* Styling for Line Edits (not readOnly) */
QLineEdit[readOnly=&quot;false&quot;] {
    background-color: #D3D3D3; /* Slightly darker background */
    border: 2px solid #1DB954; /* Spotify green border */
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}

/* Hover effect for Line Edits (not readOnly) */
QLineEdit[readOnly=&quot;false&quot;]:hover {
    background-color: #1E1E1E; /* Slightly lighter background on hover */
    border-color: #33A2FF; /* Light blue border on hover */
}

/* Focus effect for Line Edits (not readOnly) */
QLineEdit[readOnly=&quot;false&quot;]:focus {
    border-color: #33A2FF; /* Light blue border on focus */
}

/* Styling for Line Edits (readOnly) */
QLineEdit[readOnly=&quot;true&quot;] {
    background-color: #1f1e1e; /* Slightly darker background */
    border: 2px solid #1DB954; /* Spotify green border */
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}

/* Style for Line Edits that are disabled */
QLineEdit:disabled {
    background-color: #666666; /* Gray background for disabled state */
    border: 2px solid #999999; /* Gray border for disabled state */
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #999999; /* Light gray text color for disabled state */
}

/* Styling for Push Buttons */
QPushButton {
    background-color: #0073e6;
    color: #ffffff;
    border: 2px solid #00509e;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 16px;
}

/* Hover effect for &quot;add&quot; QPushButton */
QPushButton[accessibleName=&quot;add&quot;]:hover {
    background-color: #107d38;
}

/* Hover effect for &quot;delete&quot; QPushButton */
QPushButton[accessibleName=&quot;delete&quot;]:hover {
    background-color: #107d38;
}

/* Styling for QTextEdit */
QTextEdit {
    background-color: #121212;
    border: 2px solid #1DB954;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}

QTextEdit:hover {
    background-color: #1E1E1E;
    border-color: #33A2FF;
}

QTextEdit:focus {
    border-color: #33A2FF;
}

/* Styling for QComboBox */
QComboBox {
    background-color: #121212;
    border: 2px solid #1DB954;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}

QComboBox:hover {
    background-color: #1E1E1E;
    border-color: #33A2FF;
}

QComboBox:focus {
    border-color: #33A2FF;
}

/* Styling for QGroupBox */
QGroupBox {
    border: none;
}

QGroupBox::title {
    color: #ffffff;
}

QGroupBox:hover {
    background-color: #1E1E1E;
}

/* Styling for QScrollBar */
QScrollBar:vertical {
    background: #121212;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #1DB954;
    min-height: 20px;
    border-radius: 5px;
}

/* Styling for QListView */
QListView {
    background-color: #121212;
    border: 2px solid #1DB954;
    border-radius: 5px;
    color: #ffffff;
    selection-background-color: #1DB954;
}

/* Styling for QTabWidget */
QTabWidget {
    background-color: #212121;
}

QTabBar::tab {
    padding: 10px 25px;
}

QTabBar::tab:selected {
    background-color: #1DB954;
    color: #ffffff;
}

QTabBar::tab:!selected {
    background-color: #212121;
    color: #b3b3b3;
}

/* Styling for QTableView and QTableWidget */
QTableView, QTableWidget {
    background-color: #02355F; /* Navy blue table background */
    border: 1px solid #666666; /* Fine gray border */
    border-radius: 5px;
    color: #ffffff;
    selection-background-color: #1DB954;
    font-size: 18px;
}

/* Header style for QTableView and QTableWidget */
QHeaderView::section {
    background-color: #1DB954;
    color: #ffffff;
    padding: 5px;
    border: 1px solid #666666; /* Fine gray borders for headers */
}

/* Row style for QTableView and QTableWidget */
QTableView::item, QTableWidget::item {
    border: 1px solid #666666; /* Fine gray row and column borders */
    padding: 5px;
}

/* Row hover effect */
QTableView::item:hover, QTableWidget::item:hover {
    background-color: #333333;
}

/* Selected row style */
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #1DB954;
    color: #ffffff;
}

/* Styling for QSpinBox and QDoubleSpinBox */
QSpinBox[readOnly=&quot;false&quot;], QDoubleSpinBox[readOnly=&quot;false&quot;] {
    background-color: #121212;
    border: 2px solid #1DB954;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}

QSpinBox[readOnly=&quot;true&quot;], QDoubleSpinBox[readOnly=&quot;true&quot;] {
    background-color: #1f1e1e;
    border: 2px solid #1DB954;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    color: #ffffff;
}</string>
